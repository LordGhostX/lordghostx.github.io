{
  "name": "lordghostx-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A dependency-free static portfolio, ready for GitHub Pages.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "preview": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
